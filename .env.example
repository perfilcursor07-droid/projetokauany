# ===========================================================================
# Banco de dados (MySQL do WAMP)
# ===========================================================================
# Formato do Prisma. No WAMP o usuario padrao costuma ser root sem senha.
DATABASE_URL="mysql://root:@localhost:3306/nails_agenda"

# Usadas pelo runner de migrations (scripts/migrate.mjs).
# Se preferir, ele tambem sabe ler o DATABASE_URL acima.
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="nails_agenda"

# ===========================================================================
# Servidor
# ===========================================================================
PORT="3333"
HOST="0.0.0.0"
NODE_ENV="development"

# URL publica da API (usada para montar a notification_url do PagBank).
# Em desenvolvimento use um tunel (ngrok/cloudflared) apontando para a API.
PUBLIC_API_URL="http://localhost:3333"

# ===========================================================================
# Autenticacao (painel admin)
# ===========================================================================
JWT_SECRET="troque-por-uma-chave-bem-grande-e-aleatoria"
JWT_EXPIRES_IN="1d"

# ===========================================================================
# PagBank (PagSeguro) - Orders API / Pix
# ===========================================================================
# Modo de pagamento: 'fake' (teste, simula pagamento) ou 'pagbank' (real).
PAYMENTS_MODE="fake"

# sandbox:    https://sandbox.api.pagseguro.com
# producao:   https://api.pagbank.com
PAGBANK_BASE_URL="https://sandbox.api.pagseguro.com"

# Token de API gerado no painel do PagBank (Bearer).
PAGBANK_TOKEN="seu-token-pagbank-aqui"

# Tempo (em minutos) que o Pix/reserva fica valido antes de expirar.
RESERVATION_MINUTES="5"
