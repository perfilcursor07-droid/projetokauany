# ==================================================
# CONFIGURAÇÃO DE PRODUÇÃO - Studio Flora
# ==================================================

NODE_ENV=production
PORT=3007

# ==================================================
# DATABASE - MySQL no CloudPanel
# ==================================================
# Formato: mysql://usuario:senha@host:porta/database?schema=public
# Substitua SUA_SENHA_MYSQL pela senha real do banco
DATABASE_URL="mysql://studioflora:SUA_SENHA_MYSQL@localhost:3306/studioflora_db?schema=public"

# ==================================================
# JWT - Autenticação
# ==================================================
# Gere uma chave forte com: openssl rand -base64 32
JWT_SECRET="SUBSTITUA-POR-UMA-CHAVE-SECRETA-FORTE-MINIMO-32-CARACTERES"
JWT_EXPIRES_IN="7d"

# ==================================================
# PAGBANK - Pagamentos PIX
# ==================================================
# Obtenha seu token em: https://minhaconta.pagseguro.uol.com.br/
PAGBANK_TOKEN="seu-token-pagbank-aqui"
PAGBANK_WEBHOOK_URL="https://studioflora.site/api/webhooks/pagbank"

# ==================================================
# WHATSAPP - Notificações (Opcional)
# ==================================================
# Ative apenas depois que a API estiver funcionando
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_PATH="./whatsapp-session"
WHATSAPP_REMINDER_HOURS=24

# ==================================================
# BUSINESS - Configuração do Negócio
# ==================================================
# Se você tiver apenas um salão, defina o slug padrão
DEFAULT_BUSINESS_SLUG="studio-flora"
